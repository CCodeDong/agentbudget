# .gitignore — 端侧多智能体预算调度 项目
#
# 原则：**只提交"人写的东西"和"小而不可再生的产物"**。
#       构建缓存一律排除——它们体积大（本项目近 60 MB）、随时可再生，
#       而且每次构建都变，提交进去会让仓库历史迅速膨胀。
#
# 排除后的仓库约 15 MB（其中 11 MB 是那个可执行文件）。

# ---------------------------------------------------------------------------
# 仓颉构建产物
# ---------------------------------------------------------------------------
# target/ 是 cjpm 的构建目录：34 MB，每次构建都变，纯缓存
projects/*/target/
# 覆盖率 HTML 是 cjpm test --coverage 的产物，可由 tools/cj.ps1 cover 重建
projects/*/_out/coverage_html/
# 构建前复制到 ASCII 镜像的临时目录（路径为 ASCII 后已不再需要，但保留以防回退）
**/cjbuild/

# 注意：**没有**排除 projects/*/bin/
#   bin/agentbudget4cj.exe（11.2 MB）是课程要求的可运行产物。
#   它确实可由 `cj.ps1 bin` 重建，但队友克隆后能直接跑演示更方便。
#   如果后续频繁重建导致仓库变大，把下面这行取消注释即可：
# projects/*/bin/

# ---------------------------------------------------------------------------
# HarmonyOS 构建产物与包管理器缓存
# ---------------------------------------------------------------------------
# hvigor / npm 的重定向缓存目录 —— 由 tools/hb.ps1 创建，约 26 MB
app/harmony/_hvhome/
app/harmony/_npmcache/
# hvigor 自己的缓存与 IDE 目录
.hvigor/
.idea/
.cxx/
# 构建输出
app/harmony/**/build/
app/harmony/**/.preview/
# 依赖
oh_modules/
node_modules/
# 签名材料（不应入库；DevEco 存在 ~/.ohos/config，若被复制进来也要排除）
*.p12
*.p7b
*.cer
*.keystore

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# 实验与工具的临时产物
# ---------------------------------------------------------------------------
# 生成的中转目录（工具脚本用）
_verify/
_tmp/
*.log
# 注意：**没有**排除 experiments/results*/
#   原始实验数据是结论的依据，必须入库（合计 1.2 MB）。

# ---------------------------------------------------------------------------
# 编辑器与操作系统
# ---------------------------------------------------------------------------
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# 本地临时文件（我调试时留下的）
# ---------------------------------------------------------------------------
_hvhome/
_npmcache/
crashlog/

# ---------------------------------------------------------------------------
# 与本项目无关 / 体积大但可另行获取的内容
# ---------------------------------------------------------------------------
# _research/bignaiwa —— 一个「合成大西瓜」网页小游戏，与本项目无关。
#   如果你其实想把它一起备份，删掉下面这行即可。
_research/

# stdx/ —— 仓颉标准扩展库的手工副本（18 MB）。
#   实测：把它移开后 `cjpm test` 仍然 29 项全过，源码只依赖标准库（std.*）。
#   获取方式与版本对应关系见仓库根目录的 `cangjie-stdx-1.0.5-windows-manual.md`。
#   注意：stdx 的版本必须与编译器严格对应（跨版本会编译通过但运行崩溃），
#   所以不要从别处随便拿一个版本放进来。
stdx/

# 编译产物（可由 python tools/olib.py build 重建）
projects/offlinelib-core/dist/

# 离线资料库工程的构建缓存
app/offlinelib/_hvhome/
app/offlinelib/_npmcache/
app/offlinelib/build/
app/offlinelib/**/build/
app/offlinelib/_out/
_out/

# ---------------------------------------------------------------------------
# 2026-11-04 整理新增
# ---------------------------------------------------------------------------
# 旧版/ —— 历史版本归档（约 75 MB）。**不进 git**，避免仓库膨胀。
#   需要找回某个旧文件时，用 git 历史：
#     git log --diff-filter=D --name-only | Select-String "文件名"
#     git show <commit>:<path> > 恢复到某处
旧版/

# PPT / 报告生成的临时目录
_out/
_stage/

# hvigor 与 npm 的重定向缓存（构建时自动重建）
app/*/_hvhome/
app/*/_npmcache/
app/*/.hvigor/
app/*/.idea/

# Office 临时锁文件（打开文档时生成，绝不应入库）
~\$*
