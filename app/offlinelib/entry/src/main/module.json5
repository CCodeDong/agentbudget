{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // deviceTypes 是**安装门槛**：设备形态不在列表里时 HAP 会被拒绝安装，
    // 不是"显示了但不好用"，是根本装不上。
    //
    // 只声明 phone 与 tablet，与 AGC 里「支持设备」勾选保持一致。
    //
    // 历史：曾经临时加过 "2in1"，只为在 MateBook Pro（2in1 / API 23）上做
    // L3 验证。该设备已回收，且 AGC 支持设备不含 PC，故已移除。
    // 若将来要支持 PC 形态，需要：① 加回 2in1 ② 在 MateBook 模拟器上验证
    // ③ 同时在 AGC 勾选 PC/2in1，三者缺一不可。
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 权限：**一个都不申请**。
    //
    // 这一栏原本从调度器工程继承来了 `ohos.permission.GET_NETWORK_INFO`
    // —— 那个应用需要读网络档位来决定"本地/边缘/云"的放置。
    // 但**离线资料库不需要**：它不判断网络，也不发任何请求。
    //
    // 留着它会带来两条实际损失：
    //   1. 我们"零网络权限"的主张就不成立了（审核和答辩都会被问）
    //   2. "单机应用免备案"的前提变得可质疑
    //
    // 所以这里刻意留空。**不要因为"以后可能要用"而加回来。**
    "requestPermissions": [],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
