{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // ⚠️ "2in1" 是**临时加的**，只为在 MateBook Pro（2in1 / API 23）上做 L3 验证。
    //
    //    提交应用市场前必须删掉这一行，理由有两条：
    //      1. AGC 里「支持设备」勾的是 手机 + 平板，与这里不一致会被审核问
    //      2. 勾了 2in1 就要保证在 PC 形态上可用，而我们的界面只针对手机/平板设计
    //
    //    加它的原因：deviceTypes 是**安装门槛**——设备形态不在列表里时
    //    HAP 会被拒绝安装，不是"显示了但不好用"，是根本装不上。
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Reading the network state is what makes the three-tier placement decision
    // possible. Note the asymmetry: the A2A / agent-framework APIs require NO
    // permission at all, while a plain network probe does.
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:reason_network_info",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
