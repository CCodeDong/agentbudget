{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // ⚠️ "2in1" 是**临时加的**，只为在 MateBook Pro（2in1 / API 23）上做 L3 验证。
    //
    //    提交应用市场前必须删掉这一行，理由有两条：
    //      1. AGC 里「支持设备」勾的是 手机 + 平板，与这里不一致会被审核问
    //      2. 勾了 2in1 就要保证在 PC 形态上可用，而我们的界面只针对手机/平板设计
    //
    //    加它的原因：deviceTypes 是**安装门槛**——设备形态不在列表里时
    //    HAP 会被拒绝安装，不是"显示了但不好用"，是根本装不上。
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 权限：**一个都不申请**。
    //
    // 这一栏原本从调度器工程继承来了 `ohos.permission.GET_NETWORK_INFO`
    // —— 那个应用需要读网络档位来决定"本地/边缘/云"的放置。
    // 但**离线资料库不需要**：它不判断网络，也不发任何请求。
    //
    // 留着它会带来两条实际损失：
    //   1. 我们"零网络权限"的主张就不成立了（审核和答辩都会被问）
    //   2. "单机应用免备案"的前提变得可质疑
    //
    // 所以这里刻意留空。**不要因为"以后可能要用"而加回来。**
    "requestPermissions": [],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
